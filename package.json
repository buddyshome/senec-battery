{
  "name": "senec-battery",
  "version": "1.21.1",
  "description": "Pull properties from Senec battery",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "npm run build && node --inspect ./dist/test/testscript.js",
    "clean": "rimraf ./dist",
    "build": "rimraf ./dist && tsc",
    "link": "npm unlink senec-battery && npm link",
    "unlink": "npm unlink senec-battery",
    "packupdate": "npm update --save",
    "preversion": "npm run build",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/buddyshome/senec-battery"
  },
  "files": [
    "README.md",
    "LICENSE",
    "src",
    "dist"
  ],
  "author": "Alexander Link",
  "license": "MIT",
  "engines": {
    "node": "^22 || ^24 || ^26"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "axios": "^1.21.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2"
  }
}
